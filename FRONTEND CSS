/* Import Google Font */ @import url('https://fonts.googleapis.com/css2? 
family=Poppins:wght@300;400;600&display=swap'); 
body { font-family: 'Poppins', sans-serif; 
display: flex; 
justify-content: center; 
align-items: center; height: 100vh; 
background-color: #f4f4f4; margin: 0; 
} 
/* Container */ 
container { 
text-align: center; 
background: white; padding: 20px; 
border-radius: 12px; 
box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1); 
width: 90%; max-width: 400px; 
animation: fadeIn 0.5s ease-in-out; 
} 
/* Heading */ 
h1 { 
font-size: 1.5rem; 
color: #333; 
} 
/* Custom File Upload Button */ 
custom-file-upload 
{ 
display: inline-block; 
padding: 12px 20px; 
background-color: #007bff; 
color: white; border-radius: 8px; 
cursor: pointer; 
font-size: 1rem; 
margin-top: 10px; 
transition: 0.3s ease-in-out; 
box-shadow: 0px 3px 10px rgba(0, 0, 0, 0.2); 
} 
custom-file-upload:hover { 
background-color: #0056b3; 
transform: scale(1.05); 
} 
/* Hide the Default File Input */ 
#imageInput {display: none; 
} 
/* Image Preview Styling */ 
#imagePreview { 
margin-top: 15px; 
text-align: center; 
max-height: 250px; 
overflow: hidden; 
border-radius: 10px; 
background: #f9f9f9; 
padding: 10px; 
#imagePreview img 
{ width: 100%; 
height: auto; border-radius: 8px; 
object-fit: cover; 
box-shadow: 0px 3px 8px rgba(0, 0, 0, 0.15); 
} 
/* Buttons Styling */ 
button { 
padding: 12px 15px; 
margin-top: 12px; 
border: none; 
border-radius: 8px; 
font-size: 1rem; 
cursor: pointer; 
transition: 0.3s ease-in-out; 
width: 100%; 
font-weight: bold; 
box-shadow: 0px 3px 8px rgba(0, 0, 0, 0.15); 
} 
/* Generate Caption Button */ 
generate-btn { 
background-color: #28a745; 
color: white; } 
generate-btn:hover { 
background-color: #218838; 
transform: scale(1.05);} 
/* Speak Caption Button */ 
.speak-btn { background-color: #ff9800; 
color: white; } 
.speak-btn:hover { background-color: #e68900; 
transform: scale(1.05); } 
/* Caption Text Styling */ 
#caption { font-size: 1rem; 
color: #333; margin-top: 10px; 
padding: 10px; 
background: #f9f9f9; 
border-radius: 8px; 
box-shadow: 0px 2px 6px rgba(0, 0, 0, 0.1); } 
/* Hover Effect for Buttons */ 
button:hover { opacity: 0.9; }/* Responsive Design */ 
@media (max-width: 480px) 
{ .container { width: 95%; 
padding: 15px; } 
h1 { 
font-size: 1.3rem;} 
button { 
font-size: 0.9rem; 
padding: 10px; 
}}
